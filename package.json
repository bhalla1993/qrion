{
  "name": "qra",
  "version": "0.0.0",
  "private": true,
  "description": "Query Risk & Scope Analyzer (QRA) monorepo scaffold.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhalla1993/qrion.git"
  },
  "homepage": "https://github.com/bhalla1993/qrion#readme",
  "bugs": {
    "url": "https://github.com/bhalla1993/qrion/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:cli && npm run build:vscode",
    "build:core": "npm run build --workspace @qra/core",
    "build:cli": "npm run build --workspace @qra/cli",
    "build:vscode": "npm run build --workspace @qra/vscode",
    "test": "npm test --workspaces",
    "clean": "npm run clean --workspaces || true"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
