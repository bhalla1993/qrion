{
  "name": "@qra/vscode",
  "displayName": "Qrion",
  "description": "Local-first Query Risk & Scope Analyzer for AI coding prompts.",
  "version": "0.0.0",
  "publisher": "qra-tools",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "qra.analyzeSelection",
        "title": "Qrion: Analyze Selected Text"
      },
      {
        "command": "qra.analyzeClipboard",
        "title": "Qrion: Analyze Clipboard Text"
      },
      {
        "command": "qra.analyzeManual",
        "title": "Qrion: Analyze Custom Query"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qra",
          "title": "Qrion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "qra": [
        {
          "id": "qra.panel",
          "name": "Qrion Panel"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"No VS Code extension tests yet\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@qra/core": "0.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  },
  "license": "MIT"
}
